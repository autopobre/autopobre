// Servidor das salas multiplayer (src/index.js). Publicar: .\wrangler deploy
// Os segredos ficam só no Cloudflare: .\wrangler secret put SENHA_ANFITRIAO, SENHA_PILOTOS e SALA_PASSE
// (este, o mesmo do servidor de contas, conta-cloudflare: é com ele que os passes das contas são conferidos).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sala-autopobre",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // On the game's own domain (its DNS is on Cloudflare): the deploy creates the record and the
  // certificate. The account's workers.dev address stays off.
  "routes": [{ "pattern": "sala.autopobre.com.br", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // SALAS: one per room. PORTEIRO: a single one for all of them (wrong passwords and sockets waiting
  // for their key, per IP, across every room). SAGUAO: a single one too, who is online for the hosts'
  // invitations (hibernating: an idle line costs nothing).
  "durable_objects": {
    "bindings": [{ "name": "SALAS", "class_name": "Sala" }, { "name": "PORTEIRO", "class_name": "Porteiro" }, { "name": "SAGUAO", "class_name": "Saguao" }]
  },
  // The free plan runs SQLite-backed Durable Objects only.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }, { "tag": "v2", "new_sqlite_classes": ["Porteiro"] }, { "tag": "v3", "new_sqlite_classes": ["Saguao"] }],
  "vars": {
    // Pages allowed to open a room: the test version at dev.autopobre.com.br (autopobre/dev) only,
    // the one site with the accounts (a room lets in only pilots signed in). The museum at
    // autopobre.com.br/dev/ (no accounts) no longer opens rooms. The local preview (INICIAR_TESTE)
    // talks to wrangler dev (&servidor=local, origins in .dev.vars), never to this server. The old
    // address (www.inteligenciamilgrau.com.br) only redirects.
    "ORIGENS": "https://dev.autopobre.com.br"
  }
}
