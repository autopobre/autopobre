// Servidor das salas multiplayer (src/index.js). Publicar: .\wrangler deploy
// A chave do grupo fica só no Cloudflare: .\wrangler secret put CHAVE_GRUPO
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sala-autopobre",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // On the game's own domain (its DNS is on Cloudflare): the deploy creates the record and the
  // certificate. The account's workers.dev address stays off.
  "routes": [{ "pattern": "sala.autopobre.com.br", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // SALAS: one per room. PORTEIRO: a single one for all of them (wrong keys and sockets waiting for
  // their key, per IP, across every room).
  "durable_objects": {
    "bindings": [{ "name": "SALAS", "class_name": "Sala" }, { "name": "PORTEIRO", "class_name": "Porteiro" }]
  },
  // The free plan runs SQLite-backed Durable Objects only.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }, { "tag": "v2", "new_sqlite_classes": ["Porteiro"] }],
  "vars": {
    // Pages allowed to open a room: the site only, the main link (whose /dev/ folder still carries
    // the multiplayer) and the test version at dev.autopobre.com.br (autopobre/dev). The local
    // preview (INICIAR_TESTE) talks to wrangler dev (&servidor=local, origins in .dev.vars), never to
    // this server. The old address (www.inteligenciamilgrau.com.br, an origin all of that account's
    // Pages projects share) only redirects here now, so it no longer opens rooms.
    "ORIGENS": "https://autopobre.com.br,https://dev.autopobre.com.br"
  }
}
