// Servidor das contas (src/index.js): dois Workers com o mesmo código e o MESMO banco (README.md, "Dois sites, um banco").
//   dev.autopobre.com.br (versão de testes):  .\wrangler deploy
//   autopobre.com.br (link principal):        .\wrangler deploy --env principal   (a partir do commit da versão publicada lá)
// Os segredos são de cada Worker (acrescente --env principal para o do principal):
//   .\wrangler secret put GOOGLE_CLIENT_SECRET   (o do projeto do Google daquele site)
//   .\wrangler secret put SEAL_KEY               (32 bytes aleatórios; um diferente em cada Worker)
// Só o do dev: o dos passes das salas multiplayer, igual ao do servidor de salas: .\wrangler secret put SALA_PASSE
// (16 caracteres ou mais, de preferência 32 bytes aleatórios; faltando ou curto, /passe-sala responde 503).
// O banco é um só: as migrações (migracoes/) valem na hora para os dois Workers, então só acrescentam (colunas, tabelas).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conta-autopobre-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // A path of the game's own site: the pages stay on GitHub Pages, /api/ comes here, so the session
  // cookie belongs to the game's origin. The account's workers.dev address stays off.
  "routes": [{ "pattern": "dev.autopobre.com.br/api/*", "zone_name": "autopobre.com.br" }],
  "workers_dev": false,
  "preview_urls": false,
  // The accounts and their sessions, the records and the lap log, for both sites. database_id comes from
  // `.\wrangler d1 create conta-autopobre-dev` (its name from when only the dev had accounts); the tables from
  // `.\wrangler d1 migrations apply conta-autopobre-dev --remote` (migracoes/).
  "d1_databases": [{ "binding": "DB", "database_name": "conta-autopobre-dev", "database_id": "26815af1-9cd8-4cb6-a355-4d6a6db04544", "migrations_dir": "migracoes" }],
  "vars": {
    // The page's origin: the only one allowed to write, and where Google sends the player back.
    "ORIGEM": "https://dev.autopobre.com.br",
    // The dev's OAuth client in the Google Cloud project autopobre-dev, which both sites share (published: any Google
    // account signs in on either; each site its own client and secret). Public: it goes in Google's address.
    "GOOGLE_CLIENT_ID": "93518128320-74sqauh7ul0s4tlro0tnqtel6vhostrg.apps.googleusercontent.com",
    // The test version: its sessions are its own, and the trusted pilots' laps go in as cases (base.js).
    "SITE": "dev"
  },
  "env": {
    // The main link: its own Worker on the same database (routes, D1 and vars are not inherited: all here).
    "principal": {
      "name": "conta-autopobre",
      "routes": [{ "pattern": "autopobre.com.br/api/*", "zone_name": "autopobre.com.br" }],
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "conta-autopobre-dev", "database_id": "26815af1-9cd8-4cb6-a355-4d6a6db04544", "migrations_dir": "migracoes" }],
      "vars": {
        "ORIGEM": "https://autopobre.com.br",
        // The main link's own OAuth client: only its redirect URI, and a secret of its own (public: it goes in Google's address).
        "GOOGLE_CLIENT_ID": "93518128320-c80g9g564p5bevqan4c8fsau0b9tl2m0.apps.googleusercontent.com",
        "SITE": "principal"
      }
    }
  }
}
