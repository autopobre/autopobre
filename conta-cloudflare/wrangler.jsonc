// Servidor das contas (src/index.js), por enquanto só no dev.autopobre.com.br. Publicar: .\wrangler deploy
// O segredo do Google fica só no Cloudflare: .\wrangler secret put GOOGLE_CLIENT_SECRET
// O dos passes das salas multiplayer também, igual ao do servidor de salas: .\wrangler secret put SALA_PASSE
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conta-autopobre-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // A path of the game's own site: the pages stay on GitHub Pages, /api/ comes here, so the session
  // cookie belongs to the game's origin. The account's workers.dev address stays off.
  "routes": [{ "pattern": "dev.autopobre.com.br/api/*", "zone_name": "autopobre.com.br" }],
  "workers_dev": false,
  "preview_urls": false,
  // The accounts and their sessions. database_id comes from `.\wrangler d1 create conta-autopobre-dev`;
  // the tables from `.\wrangler d1 migrations apply conta-autopobre-dev --remote` (migracoes/).
  "d1_databases": [{ "binding": "DB", "database_name": "conta-autopobre-dev", "database_id": "26815af1-9cd8-4cb6-a355-4d6a6db04544", "migrations_dir": "migracoes" }],
  "vars": {
    // The page's origin: the only one allowed to write, and where Google sends the player back.
    "ORIGEM": "https://dev.autopobre.com.br",
    // The OAuth client of the Google Cloud project autopobre-dev (public: it goes in Google's address).
    "GOOGLE_CLIENT_ID": "93518128320-74sqauh7ul0s4tlro0tnqtel6vhostrg.apps.googleusercontent.com",
    // Where the main link's old records come from: the bridge page at its root (levar-recordes.html, published
    // by pages.yml). The game hops there once per account; remove it to stop the hop.
    "PONTE_RECORDES": "https://autopobre.com.br"
  }
}
